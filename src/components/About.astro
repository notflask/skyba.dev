---
import data from '../../content/landing.json';

const { about } = data;
---

<section id="ueber-mich" class="section border-t border-line">
  <div class="wrap grid gap-y-10 lg:grid-cols-12 lg:gap-x-10">
    <div class="lg:col-span-4">
      <h2 class="h-section lg:sticky lg:top-28 reveal">{about.heading}</h2>
    </div>

    <div class="lg:col-span-8">
      <p class="statement reveal">{about.statement}</p>

      <div class="prose mt-10 md:mt-12 reveal">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>
