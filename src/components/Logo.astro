  <rect x="2" y="2" width="60" height="60" rx="15.5" fill="var(--ink)"></rect>
  <path
    fill="var(--bg)"
    transform="scale(0.94) translate(1.8, 2.5)"
    d="M 44.5 22.5 L 37.8 22.5 C 37.8 18.2 34.2 15.8 28.5 15.8 C 21.2 15.8 16.2 19.8 16.2 25.5 C 16.2 30.8 20.2 33.8 26.8 35.8 L 32.8 37.8 C 41.2 40.4 45.8 44 45.8 50.5 C 45.8 57.5 39.5 61.5 29.8 61.5 C 20.5 61.5 14.5 56.8 14 49 L 21.2 49 C 21.8 53.2 25.2 55.5 29.8 55.5 C 35.2 55.5 38.6 52.8 38.6 48.6 C 38.6 43.4 34.4 40.8 27.8 38.8 L 21.8 36.8 C 14.6 34.2 9.6 30.2 9.6 24.2 C 9.6 16.5 16.8 11.5 28.5 11.5 C 39.2 11.5 44.5 16.8 44.5 22.5 Z"
  ></path>
  <circle cx="49.5" cy="50.5" r="4.4" fill="var(--bg)"></circle>
</svg>
